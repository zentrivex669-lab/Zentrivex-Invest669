# ─────────────────────────────────────────────
# Zentrivex — Environment Variables Reference
# ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# On Vercel, add these in Project Settings → Environment Variables.

# ── Database (required) ──────────────────────
# PostgreSQL connection string.
# Recommended providers: Neon (neon.tech), Supabase, Railway.
DATABASE_URL=postgresql://user:password@host:5432/zentrivex_db

# ── Authentication (required) ─────────────────
# Random secret for signing JWT tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# Initial admin password used only when the database has no admin account.
# Do not commit the real value. Change it after the first admin login.
ADMIN_SEED_PASSWORD=change_this_to_a_strong_random_password

# ── App URL (required) ────────────────────────
# Public URL of the deployed frontend (used in emails).
# Example: https://zentrivex-invest.vercel.app
APP_URL=https://your-app.vercel.app

# ── Email (optional) ──────────────────────────
# Gmail address and App Password for sending transactional emails.
# To generate an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Cron Secret (required if using Vercel Cron) ──
# Protects the /api/cron/profit endpoint from unauthorized calls.
# Set the same value as the Authorization header in your cron caller.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change_this_to_a_random_secret

# ── Server (required for VPS/local dev only) ──
# Not needed on Vercel — Vercel manages ports automatically.
PORT=3000

# ── Node Environment ─────────────────────────
NODE_ENV=production
