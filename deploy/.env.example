# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://zentrivex_user:CHANGE_THIS_PASSWORD@localhost:5432/zentrivex_db

# ─── API Server ───────────────────────────────────────────────────────────────
# Internal port the Express server listens on (Nginx proxies this)
PORT=3000

# Must be "production" on VPS
NODE_ENV=production

# JWT secret — use a strong random string: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# Used only when the database has no initial admin account
ADMIN_SEED_PASSWORD=CHANGE_THIS_TO_A_STRONG_RANDOM_PASSWORD

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Your Gmail address used for sending notifications
EMAIL_USER=your@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: myaccount.google.com → Security → 2-Step Verification → App Passwords
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# ─── Optional ─────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error (default: info)
LOG_LEVEL=info
